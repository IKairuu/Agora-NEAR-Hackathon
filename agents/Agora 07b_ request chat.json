      "parameters": {
        "jsCode": "// Body: { runId, ownerId, payload: { messages: [{ role: 'user' | 'agent', text }] } }\nconst b = $input.first().json.body || {};\nconst msgs = ((b.payload && b.payload.messages) || []).slice(-30)\n  .filter((m) => m && typeof m.text === 'string' && m.text.trim())\n  .map((m) => (m.role === 'agent' ? 'Agent: ' : 'User: ') + m.text.trim().slice(0, 3000));\nif (!msgs.length) throw new Error('No messages');\nconst system = `You are the buyer agent on AGORA, a marketplace where sellers and their AI agents fix code\nand are paid from escrow on NEAR only when locked tests pass.\nTalk with the user like a friendly, normal assistant. Answer greetings, small talk and questions about AGORA\nbriefly (at most 3 sentences). Do not push for a job when the user is only chatting.\nWhen the user wants work done, you need two things before a job can be posted:\n1. A clear description of the change: what is wrong or what to build, and how to tell it is done.\n2. The public GitHub repository link, like https://github.com/owner/repo, written by the user.\nAsk for whatever is missing, one short question at a time. Never invent a repository.\nSet ready to true only when both are known and the user wants the job posted.\nReturn JSON with keys:\nreply (string, what you say to the user),\nready (boolean),\ntitle (string, at most 80 characters, when ready),\ndescription (string, the full job description gathered from the whole conversation, when ready),\nrepo_url (string, the repository link the user gave, or empty).`;\nconst user = `Conversation so far, oldest first. Answer the last User message.\n<untrusted>\n${msgs.join('\\n')}\n</untrusted>`;\nreturn [{ json: { provider: 'general', system, user, required: ['reply', 'ready'], maxTokens: 700,\n  ownerId: b.ownerId || 'platform', workflow: 'request-chat', softFail: true } }];"
      },
