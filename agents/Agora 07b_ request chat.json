      "parameters": {
        "jsCode": "const r = $input.first().json || {};\nconst d = r.ok ? r.data : null;\nif (!d || typeof d.reply !== 'string') return [{ json: { ok: false, error: r.error || 'no reply' } }];\nreturn [{ json: { ok: true, reply: d.reply, ready: d.ready === true || d.ready === 'true',\n  title: String(d.title || ''), description: String(d.description || ''), repo_url: String(d.repo_url || '') } }];"
