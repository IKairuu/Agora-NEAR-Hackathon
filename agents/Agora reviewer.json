    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT d.id AS delivery_id, d.commit_sha, d.repo_url, d.attempt,\n       m.idx AS milestone_idx, m.job_id, j.base_commit, j.buyer_id,\n       a.test_command, a.build_command, a.failing_tests, a.allowed_paths,\n       a.test_files, a.spec_hash, a.locked_at,\n       (SELECT id FROM agents WHERE role = 'reviewer'\n         ORDER BY label OFFSET ($2::int - 1) LIMIT 1) AS reviewer_agent_id\nFROM deliveries d\nJOIN milestones m ON m.id = d.milestone_id\nJOIN jobs j ON j.id = m.job_id\nLEFT JOIN LATERAL (\n  SELECT * FROM acceptance_specs s\n   WHERE s.job_id = j.id AND s.locked_at IS NOT NULL\n   ORDER BY s.version DESC LIMIT 1) a ON true\nWHERE d.id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ [ $json.deliveryId, $json.reviewer ] }}"
        }
      },
      "id": "5933a04b-4799-41d5-82ed-059144854659",
