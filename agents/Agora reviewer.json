    {
      "parameters": {
        "jsCode": "const k = $('Required checks').first().json;\nconst llm = $input.first().json;\nconst llmOk = Boolean(llm && llm.ok === true && llm.data);\nconst suspicious = llmOk ? Boolean(llm.data.suspicious) : false;\nconst approve = k.requiredOk && !suspicious;\nconst failed = Object.entries(k.checks).filter(([, v]) => !v).map(([name]) => name);\nreturn [{ json: {\n  approve, failed, suspicious,\n  checkResults: { ...k.checks, suspicious, why: llmOk ? llm.data.why : null,\n                  qualityNotes: llmOk ? llm.data.qualityNotes : 'model unavailable' },\n  attestationHash: llmOk ? llm.attestationHash : null, model: llmOk ? llm.model : null,\n  logHash: k.logHash, logPath: k.logPath, durationMs: k.durationMs,\n} }];"
      },
