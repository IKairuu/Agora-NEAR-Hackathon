    {
      "parameters": {
        "jsCode": "const env = $('Read envelope').first().json;\nconst c = $('Prepare run').first().json;\nconst v = $('Decide').first().json;\nconst tx = $('Chain call').first().json;\nconst reason = tx.rejectedBy || 'chain error';\nreturn [{ json: {\n  runId: env.runId, ownerId: c.buyer_id, agentId: c.reviewer_agent_id, jobId: c.job_id,\n  actorLabel: `Reviewer ${c.reviewer}`, message: `Reviewer ${c.reviewer} vote refused: ${reason}`, severity: 'block',\n  data: { deliveryId: c.delivery_id, approve: v.approve, refused: true, rejectedBy: tx.rejectedBy,\n          error: tx.error, logHash: v.logHash, voteTx: null, txId: tx.txId },\n  notify: { runId: env.runId, role: 'reviewer', ok: false, jobId: c.job_id,\n            result: { deliveryId: c.delivery_id, reviewer: c.reviewer, approve: v.approve,\n                      voteTx: null, voteOk: false, rejectedBy: tx.rejectedBy }, error: tx.error },\n} }];"
