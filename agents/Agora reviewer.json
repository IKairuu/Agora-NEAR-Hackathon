    {
      "parameters": {
        "jsCode": "const env = $('Read envelope').first().json;\nconst c = $('Prepare run').first().json;\nconst v = $('Decide').first().json;\nconst tx = $('Chain call').first().json;\nconst message = v.approve\n  ? `Reviewer ${c.reviewer} approved: tests pass, diff stays in scope`\n  : `Reviewer ${c.reviewer} rejected: ${v.failed.concat(v.suspicious ? ['suspicious'] : []).join(', ')}`;\nreturn [{ json: {\n  runId: env.runId, ownerId: c.buyer_id, agentId: c.reviewer_agent_id, jobId: c.job_id,\n  actorLabel: `Reviewer ${c.reviewer}`, message, severity: v.approve ? 'ok' : 'block',\n  data: { deliveryId: c.delivery_id, approve: v.approve, failed: v.failed,\n          logHash: v.logHash, attestationHash: v.attestationHash, voteTx: tx.txHash },\n  notify: { runId: env.runId, role: 'reviewer', ok: true, jobId: c.job_id,\n            result: { deliveryId: c.delivery_id, reviewer: c.reviewer, approve: v.approve,\n                      voteTx: tx.txHash, voteOk: tx.ok }, error: null },\n} }];"
      },
