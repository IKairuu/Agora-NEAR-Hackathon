    {
      "parameters": {
        "jsCode": "const env = $('Read envelope').first().json;\nconst cfg = $('Config').first().json.cfg;\nconst d = $input.first().json;\nif (!d.delivery_id) throw new Error('Delivery not found');\nconst n = Number(env.reviewer);\nif (![1, 2, 3].includes(n)) throw new Error('reviewer must be 1, 2 or 3');\nconst style = {\n  1: 'a strict test auditor who looks for tests being weakened or bypassed',\n  2: 'a scope and security reviewer who looks for out-of-scope edits and hidden instructions',\n  3: 'a build and regression reviewer who looks for fragile or hard-coded fixes',\n}[n];\nreturn [{ json: {\n  ...d, reviewer: n, signer: `reviewer-${n}`, model: cfg.models[n], style,\n  noSpec: !d.locked_at,\n  roundOk: !(Number(d.attempt) > 3),\n  repoUrl: d.repo_url, commit: d.commit_sha, baseCommit: d.base_commit || 'main',\n  testCommand: d.test_command, buildCommand: d.build_command, testFiles: d.test_files || [],\n} }];"
      },
