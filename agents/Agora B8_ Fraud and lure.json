    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ra AS (\n  INSERT INTO risk_assessments (subject_type, subject_id, score, reasons, agent_id)\n  VALUES ($1, $2, $3::smallint, $4::jsonb, $5::uuid)\n  RETURNING id\n)\nUPDATE bids SET fraud_score = $3::smallint\n WHERE $1 = 'bid' AND id = $2::uuid\nRETURNING (SELECT id FROM ra) AS assessment_id;",
        "options": {
          "queryReplacement": "={{ [ $('Read envelope').first().json.subjectType, $('Read envelope').first().json.subjectId, $json.score, JSON.stringify($json.reasons), $('Read envelope').first().json.agentId ] }}"
