    {
      "parameters": {
        "jsCode": "const env = $('Read envelope').first().json;\nconst s = $('Score').first().json;\nconst top = s.reasons.slice(0, 2).map((r) => r.reason).join('; ') || 'no warning signs';\nlet severity = 'ok', verdict = 'clear';\nif (s.score >= 70) { severity = 'block'; verdict = 'blocked'; }\nelse if (s.score >= 40) { severity = 'hold'; verdict = 'needs owner OK'; }\nreturn [{ json: {\n  runId: env.runId, ownerId: env.ownerId, agentId: env.agentId, jobId: env.jobId || s.jobId,\n  actorLabel: 'Fraud and lure',\n  message: `Risk ${s.score}/100 on ${env.subjectType} (${verdict}): ${top}`,\n  severity, data: { subjectType: env.subjectType, subjectId: env.subjectId, score: s.score, reasons: s.reasons },\n  notify: { runId: env.runId, role: 'fraud_lure', ok: true, jobId: env.jobId || s.jobId,\n            result: { subjectType: env.subjectType, subjectId: env.subjectId, score: s.score, verdict },\n            error: null },\n} }];"
      },
