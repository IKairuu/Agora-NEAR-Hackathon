    {
      "parameters": {
        "jsCode": "const s = $('Rule signals').first().json;\nconst llm = $input.first().json;\nconst extra = (llm && llm.data && Array.isArray(llm.data.signals) ? llm.data.signals : [])\n  .slice(0, 3)\n  .map((x) => ({ reason: String(x.reason || '').slice(0, 160),\n                 weight: Math.min(Math.max(parseInt(x.weight, 10) || 0, 0), 40), source: 'model' }))\n  .filter((x) => x.reason && x.weight > 0);\nconst all = [...s.signals, ...extra].sort((a, b) => b.weight - a.weight);\nconst score = Math.min(100, all.reduce((a, x) => a + x.weight, 0));\nreturn [{ json: {\n  score, reasons: all.slice(0, 5), llmFailed: Boolean(llm && llm.error),\n  jobId: s.job_id,\n} }];"
      },
      "id": "680f9657-c2e3-4eee-8de4-8cac8edb155e",
      "name": "Score",
