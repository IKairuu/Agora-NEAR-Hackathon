    {
      "parameters": {
        "jsCode": "// Webhook output has the request body under $json.body.\n// Flatten the envelope and its payload into one item.\nconst b = $input.first().json.body || {};\nif (!b.runId) throw new Error('Missing runId in the request body');\nreturn [{\n  json: {\n    runId: b.runId,\n    ownerId: b.ownerId ?? null,\n    jobId: b.jobId ?? null,\n    agentId: b.agentId ?? null,\n    ...(b.payload || {}),\n  },\n}];"
      },
      "id": "74f1bcc8-d36b-4b4a-ba5a-03f05b59fbf6",
      "name": "Read envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        16
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH bid AS (\n  SELECT b.job_id, b.price_check::text AS price_check,\n         concat_ws(' | ', b.note, b.seller_explanation, s.headline, s.delivery_terms) AS text,\n         s.created_at AS seller_created_at, coalesce(r.settled_jobs, 0) AS settled_jobs\n  FROM bids b\n  JOIN sellers s ON s.id = b.seller_id\n  LEFT JOIN reputation r ON r.account_id = s.near_account_id\n  WHERE $1 = 'bid' AND b.id = $2::uuid\n), msg AS (\n  SELECT job_id, body AS text FROM negotiation_messages\n  WHERE $1 = 'message' AND id = $2::uuid\n)\nSELECT coalesce(bid.job_id, msg.job_id) AS job_id,\n       coalesce(bid.text, msg.text, '') AS text,\n       bid.price_check, bid.seller_created_at, bid.settled_jobs\nFROM (SELECT 1) one\nLEFT JOIN bid ON true\nLEFT JOIN msg ON true;",
        "options": {
          "queryReplacement": "={{ [ $('Read envelope').first().json.subjectType, $('Read envelope').first().json.subjectId ] }}"
        }
      },
      "id": "d16445d5-c5b7-4c8d-b6c6-72b5059db22e",
      "name": "Load subject",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "alwaysOutputData": true,
      "position": [
        560,
        -16
      ],
      "credentials": {
        "postgres": {
          "id": "POG2JEry8B8qAyP2",
          "name": "Agora Supabase"
        }
      }
