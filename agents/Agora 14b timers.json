        "jsCode": "return $input.all().map(({ json: m }) => ({ json: {\n  signer: 'platform', method: 'release_expired',\n  args: { job_id: m.job_id, milestone_idx: m.idx },\n  ownerId: m.buyer_id, jobId: m.job_id, amount: Number(m.amount),\n} }));"
