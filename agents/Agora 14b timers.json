    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT j.id AS job_id, j.buyer_id\nFROM jobs j\nWHERE j.status = 'open' AND j.accepted_bid_id IS NULL\n  AND j.posted_at <= now() - make_interval(mins => $1::int)\n  AND j.posted_at >  now() - make_interval(mins => $1::int) - interval '1 minute'\n  AND EXISTS (SELECT 1 FROM bids b WHERE b.job_id = j.id AND b.status IN ('live', 'shortlisted'));",
        "options": {
          "queryReplacement": "={{ [ $json.cfg.windowMinutes ] }}"
        }
      },
