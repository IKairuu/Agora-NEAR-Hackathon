    {
      "parameters": {
        "jsCode": "return $input.all().map(({ json: r }) => ({ json: {\n  runId: 'timer-' + Date.now(), ownerId: r.ownerId, agentId: null, jobId: r.jobId,\n  actorLabel: 'Auto-release',\n  message: r.ok\n    ? `Released ${r.amount} USDC: no dispute before the review window ended (tx ${r.txHash})`\n    : `Auto-release refused: ${r.error}`,\n  severity: r.ok ? 'ok' : 'block',\n  data: { txHash: r.txHash, ok: r.ok },\n  notify: { runId: 'timer-' + Date.now(), role: 'auto_release', ok: r.ok, jobId: r.jobId,\n            result: { txHash: r.txHash }, error: r.error || null },\n} }));"
      },
