    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT m.job_id, m.idx, m.amount, j.buyer_id\nFROM milestones m\nJOIN jobs j ON j.id = m.job_id\nWHERE m.status = 'in_review' AND m.review_deadline < now()\n  AND NOT EXISTS (SELECT 1 FROM disputes d\n                   WHERE d.milestone_id = m.id AND d.status <> 'resolved')\n  AND NOT EXISTS (SELECT 1 FROM chain_txs c\n                   WHERE c.job_id = m.job_id AND c.method = 'release_expired'\n                     AND c.args->>'milestone_idx' = m.idx::text AND c.status <> 'rejected');",
        "options": {}
      },
