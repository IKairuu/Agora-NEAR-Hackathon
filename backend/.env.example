# Copy to .env and fill in. Never commit .env.

# Supabase: Project > Connect > ORMs > Prisma.
# DATABASE_URL is the transaction pooler (port 6543) used by the app.
# DIRECT_URL is the session pooler or direct connection (port 5432) used for migrations.
DATABASE_URL=
DIRECT_URL=

PORT=3000
CORS_ORIGIN=http://localhost:5173

# Supabase: Project Settings > API. The backend verifies the user's Supabase access token.
# Projects with asymmetric signing keys only need SUPABASE_URL.
# Projects on the legacy HS256 secret also need SUPABASE_JWT_SECRET.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# NEAR. Keep AGORA_CHAIN_MODE=mock until the contract is deployed to testnet.
AGORA_CHAIN_MODE=mock
NEAR_NETWORK=testnet
AGORA_CONTRACT_ID=
AGORA_USDC_CONTRACT_ID=

# Test runner and internal endpoints.
AGORA_RUNNER_URL=http://localhost:4100
AGORA_RUNNER_KEY=
AGORA_INTERNAL_KEY=
# Where the runner and n8n call this API back.
AGORA_NEST_URL=http://localhost:3000/api

# 32-byte key (64 hex chars) that encrypts the hidden budget maximum. Generate with: openssl rand -hex 32
AGORA_LIMIT_KEY=

# n8n agents. Leave AGORA_N8N_URL empty to skip dispatching agents.
# The header name must match the "AGORA webhook in" credential in n8n.
AGORA_N8N_URL=
AGORA_N8N_WEBHOOK_HEADER=x-agora-key
AGORA_N8N_WEBHOOK_KEY=

# Contract accounts used by platform calls and the mock indexer.
AGORA_PLATFORM_ACCOUNT=agora-testnet.testnet
AGORA_DAO_ACCOUNT=agora-dao.sputnikv2.testnet
AGORA_FEE_BPS=200
