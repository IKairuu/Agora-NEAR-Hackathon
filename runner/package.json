{
    "name": "agora-runner",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/main.js",
        "dev": "tsx watch src/main.ts",
        "image": "docker build -t agora-runner-rust images/rust",
        "test": "tsx --test test/*.test.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "holdout:keys": "tsx scripts/holdout-keys.ts",
        "test:j1042": "tsx scripts/j1042.ts"
    },
    "dependencies": {
        "dotenv": "^16.6.1",
        "express": "^5.3.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
